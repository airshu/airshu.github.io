<article id="<%= post.layout %>-<%= post.slug %>" class="article article-type-<%= post.layout %>" itemscope itemprop="blogPost">
    <div class="article-inner">
        <% if (post.banner) { %>
            <%- partial('post/banner') %>
        <% } %>
        <% if (post.link || post.title) { %>
            <header class="article-header">
                <% if (post.layout != 'page') { %>
                    <div class="article-meta">
                        <%- partial('post/category') %>
                        <%- partial('post/tag') %>
                        <%- partial('post/date', { class_name: 'article-date', date_format: null }) %>
                        <% if (!index && theme.plugins.busuanzi_count && theme.comment.waline) { %>
                            <i class="fa fa-bar-chart"></i>
                            <span class="waline-pageview-count" data-path="<%- url_for(post.path) %>"></span>
                        <% } %>
                        <% if (theme.history_control.enable) { 
                            let repertory_address = `${theme.history_control.server_link}/${theme.history_control.user}/${theme.history_control.repertory}`;
                            let file_path = `${theme.history_control.branch}/source/${post.source}`;%>
                            <div class="article-meta-button">
                                <a href='<%= `${repertory_address}/raw/${file_path}` %>'> Source </a>
                            </div>
                            <div class="article-meta-button">
                                <a href='<%= `${repertory_address}/edit/${file_path}` %>'> Edit </a>
                            </div>
                            <div class="article-meta-button">
                                <a href='<%= `${repertory_address}/commits/${file_path}` %>'> History </a>
                            </div>
                        <% } %>
                    </div>
                <% } %>
                <%- partial('post/title', { class_name: 'article-title' }) %>
            </header>
        <% } %>
        <%- partial('post/gallery') %>
        <div class="article-entry" itemprop="articleBody">
        <% var show_all_content = true %>
        <% if (index) { %>
            <% if (post.excerpt || post.description) { %>
                <% show_all_content = false %>
                <p><%- post.excerpt || post.description %></p>
            <% } else if (theme.auto_excerpt.enable) { %>
                <% var br_position = 0 %>
                <% for (var br_count = 0; br_count < theme.auto_excerpt.lines; br_count++) { %>
                    <% br_position = post.content.indexOf('\n',br_position + 1) %>
                    <% if(br_position < 0) { break } %>
                <% } %>
                <% if(br_position > 0) { %>
                    <% show_all_content = false %>
                    <% /* cut back to the last complete block tag so excerpts never split mid-element */ %>
                    <% var excerpt = post.content.substring(0, br_position + 1) %>
                    <% var blockEnd = Math.max(excerpt.lastIndexOf('</p>'), excerpt.lastIndexOf('</h1>'), excerpt.lastIndexOf('</h2>'), excerpt.lastIndexOf('</h3>'), excerpt.lastIndexOf('</blockquote>'), excerpt.lastIndexOf('</figure>'), excerpt.lastIndexOf('</ul>'), excerpt.lastIndexOf('</ol>'), excerpt.lastIndexOf('</table>')) %>
                    <% if (blockEnd > 0) { excerpt = excerpt.substring(0, blockEnd) } %>
                    <div class="article-excerpt"><%- excerpt %></div>
                <% } %>
            <% } %>
        <% } else { %>
            <% if (post.toc) { %>
                <div id="toc" class="toc-article">
                <div id="toc-content">
                    <%- toc(post.content, {list_number: false}) %>
                </div>
                </div>
                <script>
                    // Anchor the fixed TOC to the article card edge immediately,
                    // before jQuery/CDN scripts load. Prevents the initial overlap frame.
                    (function () {
                        function alignToc() {
                            if (!window.matchMedia('(min-width: 1200px)').matches) return;
                            var card = document.querySelector('.article-inner');
                            if (!card) return;
                            // gap 12 on each side of the TOC; width shrinks when the
                            // space between card and viewport edge is tight
                            var width = Math.min(300, document.documentElement.clientWidth
                                - card.getBoundingClientRect().right - 24);
                            document.documentElement.style.setProperty('--toc-right', '12px');
                            document.documentElement.style.setProperty('--toc-width', width + 'px');
                        }
                        alignToc();
                        window.addEventListener('resize', alignToc);
                        // main.js calls this after toggling the sidebar so the TOC
                        // re-measures against the post-toggle card position
                        window.__alignToc = alignToc;
                        // re-measure whenever the card box actually changes (sidebar
                        // collapse/expand, window resize, font load)
                        if (window.ResizeObserver) {
                            new ResizeObserver(alignToc).observe(document.querySelector('.article-inner'));
                        }
                    })();
                </script>

            <% } %>
        <% } %>
        <% if (show_all_content) { %>
            <%- post.content %>
            </div>
        <% } else { %>
            </div>   
            <div class="article-more-link">
                <a href="<%- url_for(post.path) %>#more"><%= __('article.more') %></a>
            </div>
        <% } %>
        <footer class="article-footer">
        </footer>
    </div>
</article>

<% if (!index) { %>
    <%- partial('post/nav') %>
<% } %>

<% if (!index) { %>
    <%- partial('comment/index') %>
<% } %>

<% if (!index){ %>
<!-- baidu url auto push script -->
<script type="text/javascript">
    !function(){var e=/([http|https]:\/\/[a-zA-Z0-9\_\.]+\.baidu\.com)/gi,r=window.location.href,o=document.referrer;if(!e.test(r)){var n="//api.share.baidu.com/s.gif";o?(n+="?r="+encodeURIComponent(document.referrer),r&&(n+="&l="+r)):r&&(n+="?l="+r);var t=new Image;t.src=n}}(window);
</script>
<% } %>