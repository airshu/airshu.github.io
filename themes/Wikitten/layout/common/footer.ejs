<footer id="footer">
    <div class="outer">
        <div id="footer-info" class="inner">
            <%= config.author || config.title %> &copy; <%= date(new Date(), 'YYYY') %> 
            <a rel="license" href="http://creativecommons.org/licenses/by-nc-nd/4.0/"><img alt="Creative Commons License" style="border-width:0" src="https://i.creativecommons.org/l/by-nc-nd/4.0/80x15.png" /></a>
            <br> Powered by <a href="http://hexo.io/" target="_blank">Hexo</a>. Theme - <a href="https://github.com/zthxxx/hexo-theme-Wikitten">wikitten</a>
            <% if (theme.plugins.busuanzi_count && theme.comment.waline) { %>
                <br><i class="fa fa-eye"></i> <span class="waline-pageview-count" data-path="/"></span>
            <% } %>
        </div>
    </div>
</footer>
<% if (theme.comment.waline && theme.plugins.busuanzi_count) { %>
<script>
(function () {
    var serverURL = '<%= theme.comment.waline.serverURL %>';
    var spans = document.querySelectorAll('.waline-pageview-count');
    if (!spans.length) return;
    var current = location.pathname;
    function fill(span, time) {
        if (typeof time === 'number') span.textContent = time;
    }
    function query(path) {
        return fetch(serverURL + '/api/article?path=' + encodeURIComponent(path) + '&type=time')
            .then(function (r) { return r.json(); })
            .then(function (res) {
                if (res.errno || !Array.isArray(res.data)) return;
                return res.data[0] && res.data[0].time;
            }).catch(function () {});
    }
    for (var i = 0; i < spans.length; i++) {
        (function (span) {
            var p = span.dataset.path;
            if (p) query(p).then(function (time) { fill(span, time); });
        })(spans[i]);
    }
    // 当前页访问计数 +1(同一页面会话只计一次)
    var incKey = 'waline-pv-inc:' + current;
    var counted = false;
    try { counted = sessionStorage.getItem(incKey) === '1'; } catch (e) {}
    if (!counted) {
        try { sessionStorage.setItem(incKey, '1'); } catch (e) {}
        fetch(serverURL + '/api/article', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ path: current, type: 'time', action: 'inc' })
        }).then(function (r) { return r.json(); })
          .then(function (res) {
              if (res.errno || !Array.isArray(res.data)) return;
              for (var i = 0; i < spans.length; i++) {
                  if (spans[i].dataset.path === current) fill(spans[i], res.data[0]);
              }
          }).catch(function () {});
    }
})();
</script>
<% } %>