<% if (typeof(script) !== 'undefined' && script) { %>
    <script type="text/javascript" src="http://v2.uyan.cc/code/uyan.js?uid=<%= theme.comment.youyan %>"></script>
<% } else { %>
    <div id="valine-comments"></div>
    <script src="https://cdn.jsdelivr.net/npm/valine@1.5/dist/Valine.min.js"></script>
    <script>
        AV.init({
            appId: "<%= theme.comment.valine.leancloud_appid %>",
            appKey: "<%= theme.comment.valine.leancloud_appkey %>",
            serverURLs: 'https://ohebxny7.lc-cn-n1-shared.com'
        });
        new Valine({
            el: '#valine-comments',
            app_id: "<%= theme.comment.valine.leancloud_appid %>",
            app_key: "<%= theme.comment.valine.leancloud_appkey %>",
            placeholder: "<%= theme.comment.valine.placeholder %>" ,
        });
        // page view counter backed by LeanCloud (replaces broken busuanzi)
        (function () {
            var path = location.pathname;
            var query = new AV.Query('Counter').equalTo('url', path);
            query.first().then(function (row) {
                if (row) {
                    row.increment('time');
                    return row.save().then(function () { return row.get('time'); });
                }
                var obj = new AV.Object('Counter');
                obj.set('url', path);
                obj.set('time', 1);
                return obj.save().then(function () { return 1; });
            }).then(function (count) {
                var el = document.getElementById('lc-pageview');
                if (el) el.textContent = count;
            }).catch(function () { /* counting is best-effort */ });
        })();
    </script>
<% } %>